# ---- Backend (server only; never expose these to the browser) ----
NODE_ENV=development
PORT=8787
# Comma-separated list of allowed frontend origins for CORS
FRONTEND_URL=http://localhost:5173
# Neon PostgreSQL connection string (include sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ---- Frontend (Vite; exposed to the browser, so non-secret only) ----
# Leave empty in development to use the Vite /api proxy.
# Set to the deployed backend origin plus /api/v1 when the frontend is hosted separately.
VITE_API_BASE_URL=
