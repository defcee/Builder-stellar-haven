# ---- Backend (server only; never expose these to the browser) ----
NODE_ENV=development
PORT=8787
# Comma-separated list of allowed frontend origins for CORS
FRONTEND_URL=http://localhost:8080
# Set the Neon PostgreSQL connection string in your local environment.
DATABASE_URL=

# Cloudinary image upload credentials (backend only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Frontend (Vite; exposed to the browser, so non-secret only) ----
# Leave empty in development to use the Vite /api proxy on port 8080.
# Set to the deployed backend origin plus /api/v1 when the frontend is hosted separately.
VITE_API_URL=
