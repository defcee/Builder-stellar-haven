{
  "ios": {
    "bundleId": "com.bizzleap.mobile",
    "version": "1.0.0",
    "buildNumber": "1",
    "displayName": "Bizzleap",
    "deploymentTarget": "13.0",
    "deviceFamily": "1,2",
    "backgroundModes": ["background-fetch", "background-processing"],
    "urlSchemes": ["bizzleap"],
    "permissions": {
      "NSCameraUsageDescription": "This app needs access to camera to take photos of your products",
      "NSPhotoLibraryUsageDescription": "This app needs access to photo library to select product images",
      "NSLocationWhenInUseUsageDescription": "This app needs access to location to show nearby businesses and customers",
      "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to location to provide location-based services",
      "NSMicrophoneUsageDescription": "This app needs access to microphone for video recordings of products",
      "NSContactsUsageDescription": "This app needs access to contacts to help you connect with other farmers and customers",
      "NSUserNotificationsUsageDescription": "This app sends notifications about new orders, messages, and business updates"
    },
    "infoPlist": {
      "CFBundleName": "Bizzleap",
      "CFBundleDisplayName": "Bizzleap",
      "CFBundleIdentifier": "com.bizzleap.mobile",
      "CFBundleVersion": "1",
      "CFBundleShortVersionString": "1.0.0",
      "LSRequiresIPhoneOS": true,
      "UIRequiredDeviceCapabilities": ["armv7"],
      "UISupportedInterfaceOrientations": [
        "UIInterfaceOrientationPortrait",
        "UIInterfaceOrientationPortraitUpsideDown"
      ],
      "UISupportedInterfaceOrientations~ipad": [
        "UIInterfaceOrientationPortrait",
        "UIInterfaceOrientationPortraitUpsideDown",
        "UIInterfaceOrientationLandscapeLeft",
        "UIInterfaceOrientationLandscapeRight"
      ],
      "UILaunchStoryboardName": "LaunchScreen",
      "UIMainStoryboardFile": "Main",
      "UIStatusBarStyle": "UIStatusBarStyleLightContent",
      "UIViewControllerBasedStatusBarAppearance": false,
      "CFBundleURLTypes": [
        {
          "CFBundleURLName": "com.bizzleap.mobile.deeplink",
          "CFBundleURLSchemes": ["bizzleap"]
        },
        {
          "CFBundleURLName": "com.bizzleap.mobile.universal",
          "CFBundleURLSchemes": ["https"]
        }
      ],
      "NSAppTransportSecurity": {
        "NSAllowsArbitraryLoads": true,
        "NSExceptionDomains": {
          "localhost": {
            "NSExceptionAllowsInsecureHTTPLoads": true,
            "NSExceptionMinimumTLSVersion": "1.0",
            "NSExceptionRequiresForwardSecrecy": false
          }
        }
      },
      "ITSAppUsesNonExemptEncryption": false,
      "UIBackgroundModes": ["background-fetch", "background-processing"]
    },
    "entitlements": {
      "com.apple.developer.associated-domains": [
        "applinks:bizzleap.com",
        "applinks:*.bizzleap.com"
      ],
      "com.apple.security.application-groups": ["group.com.bizzleap.mobile"]
    },
    "buildSettings": {
      "DEVELOPMENT_TEAM": "",
      "CODE_SIGN_STYLE": "Automatic",
      "PRODUCT_BUNDLE_IDENTIFIER": "com.bizzleap.mobile",
      "MARKETING_VERSION": "1.0.0",
      "CURRENT_PROJECT_VERSION": "1",
      "SWIFT_VERSION": "5.0",
      "IPHONEOS_DEPLOYMENT_TARGET": "13.0",
      "ENABLE_BITCODE": false,
      "SWIFT_OBJC_BRIDGING_HEADER": "App/App-Bridging-Header.h",
      "ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES": true,
      "LD_RUNPATH_SEARCH_PATHS": ["$(inherited)", "@executable_path/Frameworks"]
    },
    "capabilities": {
      "push-notifications": true,
      "background-modes": true,
      "camera": true,
      "location": true,
      "photo-library": true
    },
    "frameworks": [
      "UIKit",
      "Foundation",
      "CoreLocation",
      "AVFoundation",
      "Photos",
      "UserNotifications",
      "WebKit",
      "SafariServices"
    ],
    "pods": {
      "platform": "ios, '13.0'",
      "use_frameworks": true,
      "dependencies": [
        "CapacitorCordova",
        "CapacitorApp",
        "CapacitorHaptics",
        "CapacitorKeyboard",
        "CapacitorStatusBar",
        "CapacitorSplashScreen",
        "CapacitorCamera",
        "CapacitorGeolocation",
        "CapacitorLocalNotifications",
        "CapacitorPushNotifications",
        "CapacitorShare",
        "CapacitorToast",
        "CapacitorDevice",
        "CapacitorNetwork",
        "CapacitorPreferences"
      ]
    },
    "appIcon": {
      "source": "AppIcon.appiconset",
      "sizes": [
        "20x20",
        "29x29",
        "40x40",
        "60x60",
        "76x76",
        "83.5x83.5",
        "1024x1024"
      ]
    },
    "launchScreen": {
      "backgroundColor": "#16a34a",
      "imageName": "splash",
      "imageMode": "scaleAspectFit"
    }
  },
  "xcode": {
    "version": "15.0",
    "buildSystem": "new"
  },
  "deployment": {
    "testflight": {
      "betaAppDescription": "Bizzleap mobile app for farmers and small businesses",
      "betaAppFeedbackEmail": "feedback@bizzleap.com"
    },
    "appstore": {
      "categories": {
        "primary": "Business",
        "secondary": "Productivity"
      },
      "keywords": [
        "farming",
        "agriculture",
        "business",
        "marketplace",
        "productivity",
        "small business"
      ],
      "description": "Empowering farmers and small businesses to grow, connect, and thrive in the digital marketplace",
      "releaseNotes": "Initial release of Bizzleap mobile app"
    }
  }
}
