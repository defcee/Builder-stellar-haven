{
  "name": "bizzleap-sme",
  "private": true,
  "version": "0.1.0",
  "description": "BizzLeap digital marketplace and business storefront platform",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run build:server && npm run build:web",
    "build:web": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:check": "tsx server/test-db.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "prettier --check \"server/routes/__tests__/**/*.test.ts\" \"server/lib/**/*.ts\" \"server/middleware/requestId.ts\" \"server/middleware/__tests__/**/*.test.ts\" \"src/pages/__tests__/**/*.test.tsx\" \"vitest.config.ts\" \".github/**/*.yml\" \"docker-compose.yml\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.61.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
